{
  "name": "taichi-dsh-official-doc",
  "version": "0.1.1",
  "description": "Official-document workspace for DSH Desktop: format checks, Markdown drafting, review, and templates.",
  "license": "MIT",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "dsh",
    "lib",
    "rules",
    "templates",
    "LICENSE",
    "README.md",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-renderer",
        "react"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1 || ^4.0.6-alpha.1 || ^4.1.0",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.2-rc.1 || ^0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.1 || ^0.2.2-rc.5",
    "react": "^18.2.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "build:client": "node scripts/build-client.mjs"
  }
}